---
import TableOfContents from 'virtual:starlight/components/TableOfContents';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isDocsPage = path.startsWith('/docs/');
const toc = Astro.locals.starlightRoute.toc;
---

{
	isDocsPage && toc && (
		<nav class="beskid-docs-toc" aria-label="On this page">
			<TableOfContents />
		</nav>
	)
}

<style>
	@layer starlight.components {
		.beskid-docs-toc {
			padding: 1.25rem var(--sl-sidebar-pad-x);
		}

		.beskid-docs-toc :global(h2) {
			margin: 0 0 0.6rem;
			color: var(--sl-color-white);
			font-size: var(--sl-text-sm);
			font-weight: 700;
		}

		.beskid-docs-toc :global(a) {
			font-size: var(--sl-text-sm);
		}

		:global(.page:has(.beskid-docs-toc) .right-sidebar-container) {
			display: none;
		}
	}
</style>
