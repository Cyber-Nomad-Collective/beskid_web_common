---
import { Astronav, MenuIcon, MenuItems, OpenIcon, CloseIcon } from 'astro-navbar';
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import BookNavChrome from '../book/BookNavChrome.astro';
import BookNavToggle from '../book/BookNavToggle.astro';
import { BESKID_SERVICES } from '../data/beskid-services';
import DocsNavChrome from '../docs/DocsNavChrome.astro';
import DocsNavToggle from '../docs/DocsNavToggle.astro';
import BeskidHubButton from './BeskidHubButton.astro';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const standardHref = BESKID_SERVICES.find((service) => service.id === 'platform-spec')?.href ?? '/docs/standard/';

const scopeLabel = (() => {
	if (path === '/' || path === '') return 'Home';
	if (path.startsWith('/docs/standard')) return 'Beskid Standard';
	if (path.startsWith('/book')) return 'The Beskid Book';
	if (path.startsWith('/downloads')) return 'Download';
	return 'Beskid';
})();

const isActive = (href: string) => {
	if (href === '/') return path === '/';
	const normalized = href.replace(/\/+$/, '');
	return path === normalized || path.startsWith(`${normalized}/`);
};

const isBook = path === '/book' || path.startsWith('/book/');
const isDocs = path === '/docs' || path.startsWith('/docs/');
---

<div class="header beskid-header">
	<Astronav closeOnClick>
		<div class="beskid-header__row">
			<div class="beskid-header__brand sl-flex">
				{isDocs && <DocsNavToggle showInTopBar />}
				{isBook && <BookNavToggle showInTopBar />}
				<a class="beskid-header__brand-logo-link" href="/" aria-label="Beskid home">
					<img class="beskid-header__brand-logo" src="/favicon.svg" alt="" width="26" height="26" />
				</a>
				<span class="beskid-header__brand-text" translate="no">
					<span class="beskid-header__brand-name">Beskid</span>
					<span class="beskid-header__brand-scope">{scopeLabel}</span>
				</span>
			</div>
			<div class="sl-flex print:hidden beskid-header__desktop right-group">
				<MenuItems class="sl-hidden md:sl-flex platform-spec-topbar-actions platform-spec-topbar-actions--labeled">
					<ul class="platform-spec-topbar-actions__list" aria-label="Primary navigation">
						<li>
							<a href="/" class:list={['platform-spec-topbar-actions__btn', isActive('/') && 'is-active']}>Home</a>
						</li>
						<li class="beskid-docs-menu">
							<details>
								<summary class:list={['platform-spec-topbar-actions__btn', isActive('/docs') && 'is-active']}>
									Learn
									<svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 6 4 4 4-4"></path></svg>
								</summary>
								<div class="beskid-docs-menu__panel">
									<a href="/docs/">
										<strong>Learn</strong>
										<span>Practical language and tooling guides.</span>
									</a>
									<a href={standardHref}>
										<strong>Standard</strong>
										<span>Normative requirements and scenarios.</span>
									</a>
									<a href="/book/">
										<strong>Book</strong>
										<span>A guided introduction to Beskid.</span>
									</a>
								</div>
							</details>
						</li>
						<li>
							<a href="/downloads/" class:list={['platform-spec-topbar-actions__btn', isActive('/downloads') && 'is-active']}>Download</a>
						</li>
					</ul>
				</MenuItems>
				<div class="sl-hidden md:sl-flex social-icons">
					<SocialIcons />
				</div>
				<div class="sl-hidden md:sl-flex beskid-header__desktop-controls">
					<ThemeSelect />
					<LanguageSelect />
				</div>
				<div class="beskid-header__hub sl-flex">
					<BeskidHubButton />
				</div>
			</div>
			<div class="md:sl-hidden print:hidden beskid-header__mobile-end">
				<MenuIcon class="beskid-header__menu-btn" aria-label="Toggle navigation menu">
					<OpenIcon>
						<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
							<path d="M4 7h16M4 12h16M4 17h16"></path>
						</svg>
					</OpenIcon>
					<CloseIcon>
						<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
							<path d="M6 6l12 12M18 6 6 18"></path>
						</svg>
					</CloseIcon>
				</MenuIcon>
				<div class="beskid-header__hub beskid-header__hub--mobile-bar">
					<BeskidHubButton />
				</div>
			</div>
		</div>
		<MenuItems class="hidden md:sl-hidden beskid-header__mobile-menu">
			<ul class="beskid-header__mobile-list" aria-label="Primary navigation mobile">
				<li>
					<a href="/" class:list={['beskid-header__mobile-link', isActive('/') && 'is-active']}>
						<svg class="beskid-header__mobile-link-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M3 11.5 12 4l9 7.5"></path>
							<path d="M5.5 10.5V20h13V10.5"></path>
						</svg>
						<span>Home</span>
					</a>
				</li>
				<li>
					<a
						href={standardHref}
						class:list={['beskid-header__mobile-link', isActive('/docs/standard') && 'is-active']}
					>
						<svg class="beskid-header__mobile-link-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H20v14.5A1.5 1.5 0 0 1 18.5 20H6.5A2.5 2.5 0 0 0 4 22V6.5z"></path>
							<path d="M8 8h8M8 12h8"></path>
						</svg>
						<span>Standard</span>
					</a>
				</li>
				<li>
					<a href="/book/" class:list={['beskid-header__mobile-link', isActive('/book') && 'is-active']}>
						<svg class="beskid-header__mobile-link-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M4 6.5A2.5 2.5 0 0 1 6.5 4H20v14.5A1.5 1.5 0 0 1 18.5 20H6.5A2.5 2.5 0 0 0 4 22V6.5z"></path>
							<path d="M8 8h8M8 12h8"></path>
						</svg>
						<span>Book</span>
					</a>
				</li>
				<li>
					<a href="/docs/" class:list={['beskid-header__mobile-link', isActive('/docs') && 'is-active']}>
						<svg class="beskid-header__mobile-link-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 3 3 7.5 12 12l9-4.5L12 3z"></path>
							<path d="M7 10v5.5c0 1.8 2.2 3.5 5 3.5s5-1.7 5-3.5V10"></path>
						</svg>
						<span>Learn</span>
					</a>
				</li>
				<li>
					<a href="/downloads/" class:list={['beskid-header__mobile-link', isActive('/downloads') && 'is-active']}>
						<svg class="beskid-header__mobile-link-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 3v11m0 0l-4-4m4 4 4-4M4 17.5h16V21H4z"></path>
						</svg>
						<span>Download</span>
					</a>
				</li>
				<li class="beskid-header__mobile-hub">
					<BeskidHubButton />
				</li>
			</ul>
		</MenuItems>
	</Astronav>
</div>
{isBook && <BookNavChrome currentPath={path} />}
{isDocs && <DocsNavChrome currentPath={path} />}

<style>
	@layer starlight.components {
		:global(.hidden) {
			display: none;
		}

		.beskid-header {
			width: 100%;
		}

		.beskid-header__row {
			display: grid;
			grid-template-columns: auto max-content;
			align-items: center;
			column-gap: clamp(0.45rem, 1.2vw, 1rem);
			row-gap: 0.35rem;
			width: 100%;
			min-height: var(--beskid-topbar-height, 3.4rem);
		}

		.beskid-header__hub {
			display: flex;
			align-items: center;
			flex-shrink: 0;
		}

		.beskid-header__hub--mobile-bar {
			display: none;
		}

		.beskid-header__brand {
			align-items: center;
			justify-self: start;
			gap: 0.45rem;
			min-width: 0;
		}

		.beskid-header__brand-logo-link {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			flex-shrink: 0;
			line-height: 0;
			border-radius: 0.35rem;
		}

		.beskid-header__brand-logo-link:focus-visible {
			outline: 2px solid var(--beskid-primary, var(--sl-color-accent));
			outline-offset: 2px;
		}

		.beskid-header__brand-logo {
			display: block;
			width: 1.625rem;
			height: 1.625rem;
		}

		.beskid-header__brand-text {
			display: inline-flex;
			align-items: baseline;
			gap: 0.35rem;
			min-width: 0;
			white-space: nowrap;
		}

		.beskid-header__brand-name {
			color: var(--sl-color-white);
			font-size: var(--sl-text-sm);
			font-weight: 800;
			letter-spacing: 0.01em;
			flex-shrink: 0;
		}

		.beskid-header__brand-scope {
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-xs);
			font-weight: 600;
			letter-spacing: 0.02em;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.beskid-header__desktop {
			justify-self: end;
			display: flex;
			align-items: center;
			gap: 0.75rem;
		}

		.beskid-docs-menu {
			position: relative;
		}

		.beskid-docs-menu summary {
			cursor: pointer;
			list-style: none;
		}

		.beskid-docs-menu summary::-webkit-details-marker {
			display: none;
		}

		.beskid-docs-menu summary svg {
			transition: transform 0.15s ease;
		}

		.beskid-docs-menu details[open] summary svg {
			transform: rotate(180deg);
		}

		.beskid-docs-menu__panel {
			position: absolute;
			top: calc(100% + 0.6rem);
			right: 0;
			z-index: 50;
			display: grid;
			grid-template-columns: repeat(3, minmax(8.5rem, 1fr));
			gap: 0.4rem;
			width: min(34rem, calc(100vw - 2rem));
			padding: 0.65rem;
			border: 1px solid var(--sl-color-gray-5);
			border-radius: 0.7rem;
			background: var(--sl-color-bg-nav);
			box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 0.35);
		}

		.beskid-docs-menu__panel a {
			display: grid;
			gap: 0.25rem;
			min-height: 4.5rem;
			padding: 0.65rem;
			border: 1px solid transparent;
			border-radius: 0.45rem;
			color: var(--sl-color-gray-2);
			text-decoration: none;
		}

		.beskid-docs-menu__panel a:hover,
		.beskid-docs-menu__panel a:focus-visible {
			border-color: color-mix(in srgb, var(--sl-color-text-accent) 50%, transparent);
			background: color-mix(in srgb, var(--sl-color-accent-low) 35%, transparent);
			color: var(--sl-color-white);
			outline: none;
		}

		.beskid-docs-menu__panel strong {
			font-size: var(--sl-text-sm);
		}

		.beskid-docs-menu__panel span {
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-xs);
			line-height: 1.35;
		}

		.beskid-header__mobile-end {
			grid-column: -1;
			grid-row: 1;
			justify-self: end;
			display: flex;
			align-items: center;
			gap: 0.35rem;
		}

		@media (min-width: 50rem) {
			.beskid-header__mobile-end {
				display: none;
			}

			.beskid-header__hub--mobile-bar {
				display: none !important;
			}
		}

		@media (max-width: 49.99rem) {
			.beskid-header__row {
				grid-template-columns: 1fr auto;
				grid-template-rows: auto auto;
			}

			.beskid-header__desktop .beskid-header__hub {
				display: none;
			}

			.beskid-header__hub--mobile-bar {
				display: flex;
			}

			.beskid-header__brand {
				grid-column: 1;
				grid-row: 1;
			}

			.beskid-header__desktop {
				display: none !important;
			}

			.beskid-docs-menu__panel {
				grid-template-columns: 1fr;
			}
		}

		.beskid-header__desktop-controls {
			align-items: center;
			gap: 0.2rem;
		}

		.beskid-header__mobile-toggle :global(button) {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 2.3rem;
			height: 2.3rem;
			border: none;
			border-radius: 0.45rem;
			background: transparent;
			color: var(--sl-color-gray-2);
		}

		.beskid-header__mobile-toggle :global(button:hover) {
			color: var(--sl-color-white);
			background: color-mix(in srgb, var(--sl-color-white) 8%, transparent);
		}

		.beskid-header__mobile-toggle svg {
			width: 1.1rem;
			height: 1.1rem;
		}

		.beskid-header__mobile-menu {
			margin-top: 0.3rem;
			border-top: 1px solid var(--sl-color-gray-5);
			padding-top: 0.45rem;
			background: var(--platform-spec-surface);
		}

		.beskid-header__mobile-list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 0.34rem;
		}

		.beskid-header__mobile-link {
			display: flex;
			align-items: center;
			justify-content: flex-start;
			gap: 0.5rem;
			min-height: 2.4rem;
			padding: 0 0.56rem;
			color: var(--sl-color-gray-2);
			font-size: var(--sl-text-sm);
			font-weight: 600;
			line-height: 1.2;
			text-decoration: none;
			border: none;
			border-bottom: 2px solid transparent;
			border-radius: 0;
			background: transparent;
			transition: color 0.14s ease, border-color 0.14s ease;
		}

		.beskid-header__mobile-link.is-active {
			color: var(--platform-spec-tab-text-active);
			border-bottom-color: color-mix(in srgb, var(--platform-spec-tab-indicator) 80%, transparent);
		}

		.beskid-header__mobile-link:hover {
			color: var(--platform-spec-tab-text-active);
			border-bottom-color: color-mix(in srgb, var(--platform-spec-tab-indicator) 55%, transparent);
		}

		.beskid-header__mobile-link:focus-visible {
			outline: none;
			color: var(--platform-spec-tab-text-active);
			border-bottom-color: var(--platform-spec-tab-indicator);
			box-shadow: inset 0 -2px 0 var(--platform-spec-tab-indicator);
		}

		.beskid-header__mobile-link-icon {
			width: 1rem;
			height: 1rem;
			flex-shrink: 0;
			display: block;
		}

		@media (min-width: 50rem) {
			.beskid-header__mobile-menu {
				display: none !important;
			}
		}

	}
</style>
