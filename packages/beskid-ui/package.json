{
	"name": "@cyber-nomad-collective/beskid-ui",
	"version": "0.2.8",
	"description": "Shared Astro/React UI for Beskid platform-spec and book reader chrome.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Cyber-Nomad-Collective/beskid_web_common.git",
		"directory": "packages/beskid-ui"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"exports": {
		".": "./src/index.ts",
		"./shell-css": "./shell-css.mjs",
		"./data/beskid-services": "./src/data/beskid-services.ts",
		"./client/beskid-hub": "./src/client/beskid-hub.ts",
		"./client/beskid-hub-entry": "./src/client/beskid-hub-entry.ts",
		"./react/BeskidHub": "./src/react/BeskidHub.tsx",
		"./styles/hub.css": "./src/styles/hub.css",
		"./platform-spec/*": "./src/platform-spec/*",
		"./starlight/*": "./src/starlight/*",
		"./book/*": "./src/book/*"
	},
	"files": [
		"src",
		"shell-css.mjs",
		"dist",
		"README.md"
	],
	"scripts": {
		"typecheck": "echo 'Typecheck @beskid/beskid-ui via Astro consumer (site/website); trudoc is checked in CI.'",
		"build:hub-client": "esbuild src/client/beskid-hub-entry.ts --bundle --format=esm --outfile=dist/beskid-hub.mjs --platform=browser"
	},
	"peerDependencies": {
		"@astrojs/starlight": ">=0.30.0",
		"astro": ">=5.0.0",
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-dom": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.13.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"esbuild": "0.25.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^5.8.2"
	},
	"dependencies": {
		"@cyber-nomad-collective/beskid-ui-react": "file:../beskid-ui-react",
		"@cyber-nomad-collective/trudoc": "^0.2.7",
		"@dagrejs/dagre": "^3.0.0",
		"@material/material-color-utilities": "^0.4.0",
		"astro-navbar": "^2.4.0",
		"d3": "^7.9.0",
		"intro.js": "^8.3.2",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"unified": "^11.0.5"
	},
	"keywords": [
		"astro",
		"starlight",
		"beskid",
		"platform-spec"
	],
	"license": "MIT"
}
