{
	"name": "@cyber-nomad-collective/beskid-ui-react",
	"version": "0.2.1",
	"shadcn": {
		"aliases": {
			"ui": "./src/components/ui",
			"utils": "./src/lib/utils",
			"hooks": "./src/hooks"
		}
	},
	"description": "Shared shadcn React components for Beskid apps (tracker, auth, admin).",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Cyber-Nomad-Collective/beskid_web_common.git",
		"directory": "packages/beskid-ui-react"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"exports": {
		".": "./src/index.ts",
		"./lib/utils": "./src/lib/utils.ts",
		"./hooks/use-mobile": "./src/hooks/use-mobile.ts",
		"./auth": "./src/components/auth/index.ts",
		"./settings": "./src/components/settings/index.ts",
		"./platform-spec": "./src/platform-spec/index.ts",
		"./platform-spec/linking": "./src/platform-spec/spec-link-picker.tsx",
		"./architecture-graph": "./src/architecture-graph/index.ts",
		"./styles/shadcn-entry.css": "./src/styles/shadcn-entry.css",
		"./styles/beskid-tokens.css": "./src/styles/beskid-tokens.css",
		"./styles/shadcn-theme.css": "./src/styles/shadcn-theme.css",
		"./styles/hub.css": "./src/styles/hub.css",
		"./ui/*": "./src/components/ui/*.tsx"
	},
	"files": [
		"src",
		"components.json",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "vitest run"
	},
	"peerDependencies": {
		"react": ">=18.0.0",
		"react-dom": ">=18.0.0"
	},
	"dependencies": {
		"@base-ui/react": "^1.5.0",
		"@cyber-nomad-collective/spec-core": "workspace:*",
		"@dagrejs/dagre": "^1.1.5",
		"@xyflow/react": "^12.11.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^0.577.0",
		"next-themes": "^0.4.6",
		"radix-ui": "^1.4.3",
		"react-day-picker": "^10.0.1",
		"react-grid-layout": "^2.2.0",
		"react-resizable-panels": "^4.11.2",
		"recharts": "3.8.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.0.2",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@testing-library/react": "^16.3.0",
		"@types/node": "^22.13.5",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^4.5.2",
		"jsdom": "^26.1.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^5.8.2",
		"vitest": "^3.2.4",
		"zod": "^4.4.3"
	},
	"license": "MIT"
}
