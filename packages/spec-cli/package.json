{
	"name": "@cyber-nomad-collective/spec-cli",
	"version": "0.2.0",
	"description": "CLI for normative platform-spec workspace management (init, validate, serve, seed, import, GitHub PR flow).",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Cyber-Nomad-Collective/beskid_web_common.git",
		"directory": "packages/spec-cli"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"bin": {
		"spec": "./bin/spec.mjs"
	},
	"main": "./src/cli.ts",
	"types": "./src/cli.ts",
	"exports": {
		".": "./src/cli.ts"
	},
	"files": [
		"bin",
		"src",
		"scripts",
		"README.md"
	],
	"scripts": {
		"postinstall": "bun run scripts/ensure-deps.ts",
		"spec": "bun src/cli.ts",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@cyber-nomad-collective/spec-core": "workspace:*",
		"yaml": "^2.9.0"
	},
	"devDependencies": {
		"@types/node": "^22.13.5",
		"typescript": "^5.8.2",
		"vitest": "^3.2.4"
	},
	"license": "MIT"
}
