{
	"name": "@cyber-nomad-collective/spec-core",
	"version": "0.2.1",
	"description": "Structured platform-spec workspace schemas, validation, MDX emit/import, and grid layout for Beskid spec tooling.",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Cyber-Nomad-Collective/beskid_web_common.git",
		"directory": "packages/spec-core"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./constants": "./src/constants.ts",
		"./workspace": "./src/workspace/schema.ts",
		"./node": "./src/node/schema.ts",
		"./content": "./src/content/schema.ts",
		"./grid-layout": "./src/grid-layout.ts",
		"./path-rules": "./src/path-rules.ts",
		"./emit-mdx": "./src/emit-mdx.ts",
		"./import-legacy-mdx": "./src/import-legacy-mdx.ts",
		"./validate-workspace": "./src/validate-workspace.ts",
		"./templates": "./src/templates.ts"
	},
	"files": [
		"src",
		"README.md"
	],
	"scripts": {
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@cyber-nomad-collective/trudoc": "^0.2.1",
		"yaml": "^2.7.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^22.13.5",
		"typescript": "^5.8.2",
		"vitest": "^3.2.4"
	},
	"license": "MIT"
}
