{
	"name": "@cyber-nomad-collective/trudoc",
	"version": "0.2.0",
	"description": "Opinionated docs validation and Starlight helpers (layout trees, CI verify, optional Astro integration).",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Cyber-Nomad-Collective/beskid_web_common.git",
		"directory": "packages/trudoc"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"bin": {
		"trudoc": "bin/trudoc.mjs",
		"trudoc-layout": "bin/trudoc-layout.mjs"
	},
	"exports": {
		".": "./src/index.ts",
		"./layout": "./src/layout/index.ts",
		"./layout/*": "./src/layout/*.ts",
		"./schema/content": "./src/schema/content.ts",
		"./integration": "./src/integration.ts",
		"./remark/trudoc-hub-fence": "./src/remark/trudoc-hub-fence.ts",
		"./scripts/remark-arch-code-fence.mjs": "./scripts/remark-arch-code-fence.mjs",
		"./scripts/remark-repo-link-fence.mjs": "./scripts/remark-repo-link-fence.mjs",
		"./scripts/remark-inline-repo-paths.mjs": "./scripts/remark-inline-repo-paths.mjs",
		"./scripts/architecture-graph-c4.mjs": "./scripts/architecture-graph-c4.mjs",
		"./platform-spec": "./src/platform-spec/index.ts",
		"./platform-spec/docs-spec": "./src/platform-spec/docs-spec/index.ts",
		"./platform-spec/docs-spec/*": "./src/platform-spec/docs-spec/*.ts",
		"./platform-spec/*": "./src/platform-spec/*.ts",
		"./verify": "./src/verify/index.ts",
		"./verify/*": "./src/verify/*.ts",
		"./book": "./src/book/index.ts",
		"./book/*": "./src/book/*.ts",
		"./grammars/beskid.tmLanguage.json": "./grammars/beskid.tmLanguage.json",
		"./grammars/load-beskid-grammar.mjs": "./grammars/load-beskid-grammar.mjs"
	},
	"files": [
		"bin",
		"src",
		"scripts",
		"grammars",
		"css",
		"README.md",
		"docs",
		"Dockerfile"
	],
	"peerDependencies": {
		"astro": ">=4.0.0"
	},
	"peerDependenciesMeta": {
		"astro": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.13.5",
		"astro": "^6.2.2",
		"tsx": "^4.19.4",
		"typescript": "^5.8.2",
		"vite": "^6.4.0"
	},
	"scripts": {
		"typecheck": "tsc -p tsconfig.json"
	},
	"dependencies": {
		"zod": "^4.4.3",
		"yaml": "^2.7.0"
	},
	"keywords": [
		"astro",
		"starlight",
		"documentation",
		"validation",
		"beskid"
	],
	"license": "MIT"
}
